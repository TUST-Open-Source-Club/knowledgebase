# 复制为 .env 后按需修改。.env 已在 .gitignore 中。
#
# 端口 5433 对应 docker-compose.yml 的映射（避开宿主机上可能已占用 5432 的其他 PG）。
DATABASE_URL=postgres://kb:kb_dev_password@localhost:5433/knowledgebase

# 连接池
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=30

# HTTP
BIND_ADDR=0.0.0.0:3000

# 软删数据保留期（设计文档 §6.1 定为 30 天）
SOFT_DELETE_RETENTION_DAYS=30

# JWT（对接文档 v1.1 §6.3）。禁止入仓真实密钥；此处仅开发占位。
JWT_SECRET=dev-only-insecure-secret-change-me
# access token 有效期（天），默认 7
JWT_TTL_DAYS=7

# 日志
RUST_LOG=knowledgebase=debug,sqlx=warn
